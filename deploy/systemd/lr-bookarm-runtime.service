[Unit]
Description=LR 机器人本机 BookArm 图书机械臂服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boreas
WorkingDirectory=/home/boreas/project/lingzu_arm/lingzu-bookarm-py/bookarm
Environment=HOME=/home/boreas
Environment=LR_BOOKARM_ROOT=/home/boreas/project/lingzu_arm/lingzu-bookarm-py/bookarm
Environment=LR_ROBOT_WORKSPACE=/home/boreas/LR/Library_robot
EnvironmentFile=-/etc/lr-robot/bookarm.env
ExecStart=/usr/local/libexec/lr-start-bookarm-runtime.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
