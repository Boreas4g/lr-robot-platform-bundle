[Unit]
Description=LR 图书馆机器人管理平台
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/boreas/lr-robot-platform-bundle/LR-Web
EnvironmentFile=-/etc/lr-platform/platform.env
ExecStart=/home/boreas/lr-robot-platform-bundle/LR-Web/scripts/start-platform.sh
ExecStop=/home/boreas/lr-robot-platform-bundle/LR-Web/scripts/stop-platform.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
