[Unit]
Description=LR XT369P read-only battery telemetry
After=lr-xt369p-rfcomm.service
Requires=lr-xt369p-rfcomm.service

[Service]
Type=simple
User=boreas
Group=boreas
SupplementaryGroups=dialout
WorkingDirectory=/home/boreas/LR/Library_robot
Environment=HOME=/home/boreas
Environment=LR_ROBOT_WORKSPACE=/home/boreas/LR/Library_robot
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ExecStart=/usr/local/libexec/lr-start-xt369p-battery.sh /etc/lr-robot/xt369p-battery.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
